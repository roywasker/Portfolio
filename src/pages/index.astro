---
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Skills from "../components/Skills.astro";
import EngineeringStory from "../components/EngineeringStory.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile, projects } from "../data/portfolio";

const title = `${profile.name} — ${profile.role}`;
const description = "Android engineer specializing in Kotlin, Jetpack Compose and high-quality mobile experiences.";
---

<BaseLayout title={title} description={description}>
  <div class="page-progress" aria-hidden="true"><span></span></div>

  <Hero />

  <section id="about" class="about-story" data-about-section aria-labelledby="about-title">
    <div class="section-shell about-shell">
      <div class="about-intro" data-reveal>
        <p class="eyebrow"><span>01</span> The person behind the code</p>
        <h2 id="about-title">CURIOUS BY NATURE.<br /><em>ENGINEER BY CRAFT.</em></h2>
      </div>
      <div class="about-copy" data-reveal>
        <p class="lead">I’m {profile.name}. I build Android experiences where the details of state, navigation and interaction matter.</p>
        <p>My experience spans Android mobile and TV, using Kotlin and Jetpack Compose. I think beyond individual screens: how people move through an app, how it responds to their actions, and how its architecture supports a consistent experience.</p>
        <p>I’m a Computer Science graduate. In my own projects, I explore shared Android and iOS experiences with Kotlin Multiplatform, local data and backend systems.</p>
        <a href={`mailto:${profile.email}`}>Let’s talk <span aria-hidden="true">↗</span></a>
      </div>
      <dl class="about-experience" data-reveal>
        <div><dt>Currently</dt><dd>{profile.currentTitle} · {profile.company}</dd></div>
        <div><dt>Since</dt><dd>{profile.employedSince}</dd></div>
        <div><dt>Foundation</dt><dd>Computer Science graduate</dd></div>
      </dl>
      <EngineeringStory />
    </div>
  </section>

  <section id="work" class="section-shell work-section" aria-labelledby="work-title">
    <div class="section-heading" data-reveal>
      <p class="eyebrow"><span>02</span> Selected work</p>
      <div>
        <h2 id="work-title">PRODUCTS WITH<br /><em>A POINT OF VIEW.</em></h2>
        <p>Start with two mobile experiences: shared commerce in Trendy and a local Android vault in MyPasswords. Explore the interfaces and the decisions behind them.</p>
      </div>
    </div>

    <div class="project-list">
      {projects.map((project, index) => <>
        {index === 2 && <p class="more-projects-label">More projects &amp; experiments</p>}
        <ProjectCard project={project} index={index} />
      </>)}
    </div>
  </section>

  <Skills />
  <Footer />
</BaseLayout>
