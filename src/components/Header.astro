---
import { navigation, profile } from "../data/portfolio";
---

<header class="site-header">
  <a class="wordmark" href="#top" aria-label={`${profile.name} — back to top`}>
    <span>{profile.name}</span>
  </a>

  <nav class="desktop-nav" aria-label="Primary navigation">
    {navigation.map((item) => <a href={item.href} data-section-link>{item.label}</a>)}
  </nav>

  <div class="header-actions">
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to light theme">
      <svg class="theme-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <g class="sun-icon">
          <circle cx="12" cy="12" r="3.5"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
        </g>
        <path class="moon-icon" d="M20 15.1A8.5 8.5 0 0 1 8.9 4a8.5 8.5 0 1 0 11.1 11.1Z"></path>
      </svg>
    </button>

    <details class="mobile-menu">
      <summary aria-label="Open navigation" aria-expanded="false"><span></span><span></span></summary>
      <nav aria-label="Mobile navigation">
        {navigation.map((item, index) => (
          <a href={item.href} data-section-link><small>0{index + 1}</small>{item.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    z-index: 50;
    top: 1rem;
    left: 50%;
    right: auto;
    translate: -50% 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(calc(68% - 1rem), 63rem);
    margin: 0;
    padding: .55rem .6rem .55rem .9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 76%, transparent);
    box-shadow: 0 12px 36px color-mix(in srgb, var(--ink) 8%, transparent);
    backdrop-filter: blur(18px) saturate(140%);
    transition: transform .35s ease, background-color .3s ease;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    width: max-content;
    height: 2.5rem;
    color: var(--ink);
  }

  .wordmark span {
    font-size: .75rem;
    font-weight: 820;
    line-height: 1;
    letter-spacing: .04em;
    text-transform: uppercase;
    transition: color .25s ease;
  }

  .wordmark:hover span,
  .wordmark:focus-visible span { color: var(--accent-strong); }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: .35rem;
  }

  .desktop-nav a {
    display: inline-flex;
    align-items: center;
    padding: .7rem 1rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: .88rem;
    font-weight: 720;
    transition: color .2s ease, background-color .2s ease, box-shadow .2s ease, transform .2s ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a:focus-visible {
    color: var(--ink);
    background: var(--surface);
  }

  .desktop-nav a[aria-current="location"] {
    color: var(--accent-ink);
    background: var(--accent);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--accent) 28%, transparent);
    font-weight: 820;
    transform: translateY(-1px);
  }

  .header-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: .4rem;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ink);
    background: var(--surface);
    cursor: pointer;
    transition: color .25s ease, background-color .25s ease, transform .25s ease;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible { color: var(--accent-strong); transform: rotate(8deg); }

  .theme-icon {
    width: 1.2rem;
    height: 1.2rem;
    overflow: visible;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sun-icon,
  .moon-icon { transform-origin: center; transition: opacity .25s ease, transform .35s ease; }
  .sun-icon { opacity: 1; transform: scale(1) rotate(0); }
  .moon-icon { opacity: 0; transform: scale(.55) rotate(30deg); }
  :global([data-theme="light"]) .sun-icon { opacity: 0; transform: scale(.55) rotate(35deg); }
  :global([data-theme="light"]) .moon-icon { opacity: 1; transform: scale(1) rotate(0); }

  .mobile-menu { display: none; }

  @media (max-width: 48rem) {
    .site-header {
      top: max(.75rem, env(safe-area-inset-top));
      grid-template-columns: minmax(0, 1fr) auto;
      width: calc(100% - 1.25rem);
      max-width: none;
      padding-left: 1rem;
    }
    .desktop-nav { display: none; }
    .mobile-menu { display: block; }
    .mobile-menu summary {
      display: grid;
      place-content: center;
      gap: .3rem;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 50%;
      background: var(--ink);
      cursor: pointer;
      list-style: none;
    }
    .mobile-menu summary::-webkit-details-marker { display: none; }
    .mobile-menu summary span {
      width: 1rem;
      height: 1px;
      background: var(--bg);
      transition: transform .25s ease;
    }
    .mobile-menu[open] summary span:first-child { transform: translateY(.17rem) rotate(45deg); }
    .mobile-menu[open] summary span:last-child { transform: translateY(-.17rem) rotate(-45deg); }
    .mobile-menu:not([open]) nav { display: none; }
    .mobile-menu[open] nav {
      position: fixed;
      z-index: 2;
      top: 5rem;
      left: 50%;
      display: grid;
      width: min(calc(100vw - 1.25rem), 34rem);
      max-height: calc(100svh - 6rem);
      overflow-y: auto;
      padding: 1rem;
      border: 1px solid var(--line);
      border-radius: 1.5rem;
      background: var(--bg);
      box-shadow: 0 20px 70px color-mix(in srgb, var(--ink) 18%, transparent);
      transform: translateX(-50%);
      animation: menu-enter .28s cubic-bezier(.2, .75, .2, 1) both;
    }
    .mobile-menu nav a {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      padding: .9rem .6rem;
      border-bottom: 1px solid var(--line);
      color: var(--ink);
      font-size: clamp(1.6rem, 8vw, 2.4rem);
      font-weight: 750;
      letter-spacing: -.06em;
    }
    .mobile-menu nav a:last-child { border: 0; }
    .mobile-menu nav small { color: var(--accent-strong); font-size: .6rem; letter-spacing: .08em; }
    .mobile-menu nav a[aria-current="location"] {
      border-radius: 1rem;
      color: var(--accent-ink);
      background: var(--accent);
      box-shadow: 0 10px 26px color-mix(in srgb, var(--accent) 22%, transparent);
      font-weight: 820;
    }
    .mobile-menu nav a[aria-current="location"] small { color: currentColor; }

    @keyframes menu-enter {
      from { opacity: 0; transform: translate(-50%, -.75rem) scale(.98); }
      to { opacity: 1; transform: translate(-50%, 0) scale(1); }
    }
  }
</style>
