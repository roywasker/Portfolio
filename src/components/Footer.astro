---
import { profile } from "../data/portfolio";

const linkedIn = profile.socials.find((social) => social.label === "LinkedIn");
---

<footer id="contact" class="section-shell site-footer">
  <p class="eyebrow"><span>04</span> Let’s build something useful</p>
  <a class="email-link" href={`mailto:${profile.email}`}>
    <span>START A</span>
    <span>CONVERSATION <i aria-hidden="true">↗</i></span>
  </a>
  <div class="contact-actions">
    <div class="contact-email">
      <p class="contact-label">Email me directly</p>
      <a class="email-address" href={`mailto:${profile.email}`}>{profile.email}</a>
      <div class="email-actions">
        <a class="button button-primary" href={`mailto:${profile.email}`}>Send an email <span aria-hidden="true">↗</span></a>
        <button class="button button-ghost copy-email" type="button" data-copy-email={profile.email} hidden>Copy email</button>
      </div>
      <p class="copy-status" role="status" aria-live="polite" aria-atomic="true" data-copy-status></p>
    </div>
    {linkedIn && (
      <a class="linkedin-contact" href={linkedIn.href} target="_blank" rel="noreferrer">
        <span class="linkedin-icon" aria-hidden="true">in</span>
        <span><strong>Connect on LinkedIn</strong><small>View my profile and get in touch</small></span>
        <span aria-hidden="true">↗</span>
        <span class="visually-hidden">Opens in a new tab</span>
      </a>
    )}
  </div>
  <div class="footer-meta">
    <p>Mobile engineering with product thinking.</p>
    <div class="social-links">
      {profile.socials.filter((social) => social.label !== "LinkedIn").map((social) => (
        <a href={social.href} target="_blank" rel="noreferrer">
          {social.label}<span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      ))}
    </div>
    <a href="#top">Back to top ↑</a>
  </div>
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <p>Built with Astro + TypeScript</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--section-space);
    padding-bottom: 1.5rem;
  }

  .email-link {
    display: block;
    width: max-content;
    max-width: 100%;
    margin-block: clamp(2.5rem, 5vw, 4.5rem);
    color: var(--ink);
    font-size: clamp(2.8rem, 7.7vw, 7.7rem);
    font-weight: 880;
    line-height: .82;
    letter-spacing: -.075em;
  }

  .email-link span { display: block; }
  .email-link span:last-child { color: var(--accent-text); }
  .email-link i { display: inline-block; font-style: normal; font-weight: 450; transition: transform .3s ease; }
  .email-link:hover i { transform: translate(.15em, -.15em); }

  .contact-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem var(--content-column-gap); align-items: start; margin-bottom: 2rem; }
  .contact-email { min-width: 0; }
  .contact-label { margin: 0 0 .5rem; color: var(--muted); font-size: .875rem; }
  .email-address { display: inline-block; padding-block: .35rem; color: var(--ink); font-size: clamp(1.15rem, 2vw, 1.7rem); letter-spacing: -.03em; overflow-wrap: anywhere; text-underline-offset: .2em; }
  .email-address:hover { text-decoration: underline; }
  .email-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; margin-top: 1.1rem; }
  .copy-email { min-width: 9rem; justify-content: center; padding: .75rem 1.25rem; cursor: pointer; }
  .copy-email[data-copied] { border-color: var(--accent-text); color: var(--accent-text); background: var(--surface-raised); }
  .copy-email[hidden] { display: none; }
  .copy-email:disabled { cursor: wait; opacity: .65; }
  .copy-status { min-height: 1.5em; margin: .6rem 0 0; color: var(--muted); font-size: .8125rem; }
  .linkedin-contact { display: flex; align-items: center; gap: 1rem; min-width: 0; padding: 1.25rem; border: 1px solid var(--line); border-radius: var(--radius-card); color: var(--ink); background: var(--surface); box-shadow: var(--shadow-card); transition: var(--interaction-transition); }
  .linkedin-contact:is(:hover, :focus-visible) { border-color: var(--accent-text); box-shadow: var(--shadow-card-hover); transform: translateY(-2px); }
  .linkedin-contact:active { transform: translateY(0); box-shadow: var(--shadow-card); }
  .linkedin-icon { display: grid; place-items: center; flex-shrink: 0; width: 2.75rem; height: 2.75rem; border-radius: var(--radius-tag); color: var(--accent-ink); background: var(--accent); font-size: 1.4rem; font-weight: 800; }
  .linkedin-contact > span:nth-child(2) { flex: 1; min-width: 0; }
  .linkedin-contact strong { display: block; font-size: 1rem; }
  .linkedin-contact small { display: block; margin-top: .3rem; color: var(--muted); font-size: .8125rem; }

  .footer-meta {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 2rem;
    align-items: end;
    padding-block: 2rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: .78rem;
  }

  .footer-meta p { max-width: 18rem; margin: 0; }
  .social-links { display: flex; flex-wrap: wrap; gap: .6rem 1.3rem; }
  .social-links a, .footer-meta > a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink);
  }
  .social-links span { color: var(--accent-strong); }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.2rem;
    color: var(--muted);
    font-size: .64rem;
    text-transform: uppercase;
    letter-spacing: .1em;
  }
  .footer-bottom p { margin: 0; }

  @media (max-width: 42rem) {
    .contact-actions { grid-template-columns: 1fr; gap: 1rem; }
    .email-link { font-size: clamp(2.2rem, 9.8vw, 3.7rem); line-height: .9; letter-spacing: -.06em; }
    .email-link span:last-child { display: flex; align-items: flex-start; gap: .08em; }
    .email-link i { flex: 0 0 auto; margin-top: .08em; font-size: .52em; }
    .footer-meta { grid-template-columns: 1fr; align-items: start; }
    .footer-meta > a { justify-self: start; }
    .social-links { gap: .25rem 1rem; }
  }
</style>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-email]");
  const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");
  let resetTimer: ReturnType<typeof setTimeout> | undefined;

  // Local-network previews may not expose the Clipboard API.
  const copyWithSelection = (email: string) => {
    const field = document.createElement("textarea");
    field.value = email;
    field.readOnly = true;
    field.style.cssText = "position:fixed;top:0;left:0;opacity:0;pointer-events:none;font-size:16px;";
    document.body.append(field);
    try {
      field.focus({ preventScroll: true });
      field.select();
      field.setSelectionRange(0, email.length);
      return document.execCommand("copy");
    } finally {
      field.remove();
    }
  };

  if (copyButton && copyStatus) {
    copyButton.hidden = false;
    copyButton.addEventListener("click", async () => {
      const email = copyButton.dataset.copyEmail;
      if (!email) return;
      clearTimeout(resetTimer);
      delete copyButton.dataset.copied;
      copyStatus.textContent = "";
      copyButton.disabled = true;
      let copied = false;
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(email);
          copied = true;
        } else {
          copied = copyWithSelection(email);
        }
      } catch {
        copied = false;
      } finally {
        copyButton.disabled = false;
        copyButton.focus({ preventScroll: true });
      }
      copyButton.textContent = copied ? "Copied ✓" : "Copy email";
      if (copied) copyButton.dataset.copied = "";
      copyStatus.textContent = copied
        ? "Email address copied to clipboard."
        : "Couldn’t copy automatically. Select the email address above to copy it manually.";
      if (copied) {
        resetTimer = setTimeout(() => {
          copyButton.textContent = "Copy email";
          delete copyButton.dataset.copied;
          copyStatus.textContent = "";
        }, 4000);
      }
    });
  }
</script>
