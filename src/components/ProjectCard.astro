---
import type { Project } from "../data/portfolio";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const smallPoster = project.poster.replace(/\.avif$/, "-320.avif");
---

<article
  class:list={["project-card", { "project-featured": project.featured }]}
  style={`--project-accent: ${project.accent}; --project-accent-light: ${project.lightAccent}; --delay: ${index * 70}ms;`}
  data-reveal="project"
>
  <a href={project.caseStudy ?? project.href} target={project.caseStudy ? undefined : "_blank"} rel={project.caseStudy ? undefined : "noreferrer"}>
    <div class="project-visual">
      <span class="visual-index">0{index + 1}</span>
      <img
        class="project-poster-image"
        src={project.poster}
        srcset={`${smallPoster} 640w, ${project.poster} 1280w`}
        sizes={project.featured ? "(max-width: 58rem) 90vw, (max-width: 92rem) 50vw, 740px" : "(max-width: 48rem) calc(100vw - 2.65rem), (max-width: 92rem) 45vw, 704px"}
        alt={`${project.title} project preview`}
        width="1280"
        height="800"
        loading="lazy"
        decoding="async"
      />
      <span class="visual-signal" aria-hidden="true"></span>
    </div>

    <div class="project-main">
      <p class="project-label">{project.featured ? `Featured project · ${project.label}` : project.label}</p>
      <h3>{project.title}</h3>
      <p class="project-description">{project.description}</p>
      {project.caseStudy && <span class="case-study-cta">Explore project <span aria-hidden="true">↗</span></span>}
    </div>

    <div class="project-footer">
      <ul aria-label={`${project.title} technologies`}>
        {project.stack.map((item) => <li>{item}</li>)}
      </ul>
      <span class="project-link" aria-hidden="true">↗</span>
    </div>

    {!project.caseStudy && <span class="visually-hidden">Opens {project.title} on GitHub in a new tab</span>}
  </a>
</article>

<style>
  .case-study-cta { display: inline-flex; align-items: center; gap: 1.25rem; min-height: 44px; padding: .75rem 1.1rem; border-radius: var(--radius-control); color: var(--accent-ink); background: var(--accent); font-size: .875rem; font-weight: 600; margin: 1.5rem 0 0; }
  .case-study-cta span { transition: transform .2s ease; }
  a:is(:hover, :focus-visible) .case-study-cta span { transform: translate(.15rem, -.15rem); }
  .project-card {
    /* Render distant cards when needed; retain their measured height afterward. */
    content-visibility: auto;
    contain-intrinsic-block-size: auto 36rem;
    --delay: 0ms;
    --project-color: var(--project-accent);
    --project-label-color: var(--project-color);
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    transition: var(--interaction-transition);
  }

  :global([data-theme="light"]) .project-card {
    --project-label-color: color-mix(in srgb, var(--project-color) 35%, var(--ink));
  }

  .project-card:hover,
  .project-card:focus-within {
    border-color: var(--accent-text);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .project-card:active { transform: translateY(0); box-shadow: var(--shadow-card); }

  .project-card a {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: .7rem;
    color: var(--ink);
  }

  .project-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(13rem, 23vw, 21rem);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius-lg) - .55rem);
    color: var(--project-color);
    background:
      radial-gradient(circle at center, color-mix(in srgb, var(--project-color) 10%, transparent), transparent 62%),
      color-mix(in srgb, var(--surface-raised) 76%, var(--bg));
    transition: border-color .35s ease;
  }

  .visual-index {
    position: absolute;
    z-index: 2;
    top: 1rem;
    left: 1rem;
    padding: .38rem .52rem;
    border: 1px solid rgba(255, 255, 255, .18);
    border-radius: var(--radius-tag);
    color: #fff;
    background: rgba(12, 14, 18, .55);
    backdrop-filter: blur(10px);
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .12em;
  }

  .visual-signal {
    position: absolute;
    z-index: 2;
    right: 1rem;
    bottom: 1rem;
    width: .52rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--project-color);
    box-shadow: 0 0 16px var(--project-color);
  }

  a:hover .project-visual,
  a:focus-visible .project-visual { border-color: color-mix(in srgb, var(--project-color) 55%, var(--line)); }

  .project-poster-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .65s cubic-bezier(.2, .8, .2, 1), filter .35s ease;
  }

  a:hover .project-poster-image,
  a:focus-visible .project-poster-image {
    transform: scale(1.035);
    filter: saturate(1.06) contrast(1.02);
  }

  .project-main { padding: clamp(1.3rem, 2.4vw, 2rem) clamp(.65rem, 1.3vw, 1.1rem) 1.5rem; }
  .project-label {
    margin: 0;
    color: var(--project-label-color);
    font-size: .75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .13em;
  }

  h3 {
    margin: .9rem 0 1rem;
    font-size: var(--card-title-size);
    line-height: 1.08;
    letter-spacing: -.04em;
  }

  .project-description {
    max-width: 38rem;
    margin: 0;
    color: var(--muted);
    font-size: clamp(.84rem, 1vw, .98rem);
    line-height: 1.68;
  }

  .project-footer {
    display: flex;
    gap: 1rem;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: auto;
    padding: 1.25rem clamp(.65rem, 1.3vw, 1.1rem) .75rem;
    border-top: 1px solid var(--line);
  }

  ul { display: flex; flex-wrap: wrap; gap: .42rem; margin: 0; padding: 0; list-style: none; }
  li {
    padding: .42rem .64rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-tag);
    color: var(--muted);
    font-size: .8125rem;
    transition: border-color .3s ease;
  }

  a:hover li,
  a:focus-visible li { color: var(--ink); border-color: color-mix(in srgb, var(--project-color) 58%, var(--line)); }

  .project-link {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.6rem;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ink);
    font-size: 1.25rem;
    transition: border-color .3s ease, transform .3s ease;
  }

  a:hover .project-link,
  a:focus-visible .project-link {
    border-color: var(--accent-text);
    color: var(--accent-text);
    background: var(--surface-raised);
    transform: translate(.2rem, -.2rem);
  }

  a:active .project-link { transform: translate(.1rem, -.1rem) scale(.96); }
  @media (prefers-reduced-motion: reduce) {
    .project-card:is(:hover, :focus-within, :active),
    a:is(:hover, :focus-visible, :active) .project-link { transform: none; }
    a:is(:hover, :focus-visible) .project-poster-image,
    a:is(:hover, :focus-visible) .case-study-cta span { transform: none; }
  }

  .project-featured { grid-column: 1 / -1; contain-intrinsic-block-size: auto 30rem; }
  .project-featured > a { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); grid-template-rows: 1fr auto; column-gap: clamp(1rem, 3vw, 3rem); }
  .project-featured .project-visual { grid-row: 1 / 3; min-height: clamp(23rem, 34vw, 31rem); }
  .project-featured .project-poster-image { object-fit: contain; }
  .project-featured .project-main { align-self: center; padding-block: 2rem; }
  .project-featured h3 { font-size: clamp(2rem, 4vw, 3.5rem); }
  .project-featured .project-description { font-size: 1rem; }
  .project-card:not(.project-featured) h3 { font-size: clamp(1.5rem, 2.5vw, 2rem); }
  .project-card:not(.project-featured) .project-visual { min-height: clamp(11rem, 19vw, 17rem); }

  @media (max-width: 58rem) {
    .project-featured > a { display: flex; }
    .project-featured .project-visual { min-height: clamp(15rem, 55vw, 28rem); }
    .project-featured .project-main { align-self: stretch; }
  }

  @media (max-width: 64rem) {
    .project-visual { min-height: clamp(13rem, 28vw, 18rem); }
  }

  @media (max-width: 48rem) {
    .project-visual { min-height: min(68vw, 20rem); }
    .project-card:not(.project-featured) .project-visual { min-height: min(52vw, 16rem); }
  }
</style>
